# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Omit WEBHOOK_URL to use long polling (recommended for a home PC).
# For webhook hosting, set this to your public HTTPS base URL with no trailing slash.
# WEBHOOK_URL=https://your-public-app.example

# Groq API key — get one free at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the AI model (default: openai/gpt-oss-120b)
# Browse models at https://console.groq.com/docs/models
# GROQ_MODEL=llama-3.3-70b-versatile
